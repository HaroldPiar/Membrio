{
  "name": "membrio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:verify": "node --env-file-if-exists=.env --import tsx scripts/verify.ts",
    "db:schema-sql": "tsx scripts/generate-schema-sql.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx scripts/dev-api.ts",
    "verify:fase2": "node --env-file-if-exists=.env --import tsx scripts/verify-fase2.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
